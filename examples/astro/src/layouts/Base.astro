---
interface Props {
  title: string;
  /**
   * TV screens are viewed from metres away and never scroll; phone screens are
   * held at arm's length and do. The two need different type scales and
   * spacing, so the surface picks its own scale rather than sharing one.
   */
  surface: "tv" | "phone";
}

const { title, surface } = Astro.props;

/**
 * The phone surfaces, in the order someone moves through them.
 *
 * Shown only on `phone`: a TV has no pointer and no keyboard, so a nav bar
 * there is clutter nobody can operate.
 */
const nav = [
  { href: `/`, label: `Home` },
  { href: `/account`, label: `Devices` },
  { href: `/link`, label: `Link` },
  { href: `/scanner`, label: `Scanner` }
];

// Compared without the trailing slash so `/link/` and `/link` both match.
const here = Astro.url.pathname.replace(/\/$/u, ``) || `/`;
---

<!doctype html>
<html lang="en" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#160c1e" />
    <style is:global>
      :root {
        --ink: #f4ecf7;
        --ink-dim: #b9a6c4;
        --accent: #f0b429;
        --ground: #160c1e;
        --ground-lift: #241634;
        --line: #3a2a4d;
        --ok: #4ade80;
        --bad: #f87171;

        color-scheme: dark;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--ink);
        /* Radial rather than flat: a large dark panel on a TV shows banding,
           and the gradient hides it while giving the QR a lighter surround. */
        background:
          radial-gradient(
            ellipse at 50% 0%,
            var(--ground-lift) 0%,
            var(--ground) 60%
          ),
          var(--ground);
        -webkit-font-smoothing: antialiased;
      }

      /* The TV never scrolls — it is a fixed 1920x1080 surface with no input
         device that could scroll it. Anything overflowing is a layout bug, so
         make it visible rather than hiding it behind a scrollbar nobody has. */
      html[data-surface="tv"],
      html[data-surface="tv"] body {
        height: 100%;
        overflow: hidden;
      }

      button {
        font: inherit;
        cursor: pointer;
      }

      /* Fire OS remotes move focus with a D-pad and there is no pointer, so a
         visible focus ring is the ONLY way to know what is selected. Never
         remove it on a TV surface. */
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Fixed to the bottom, where a thumb reaches on a phone. `env()` keeps
         it clear of the home indicator on a notched device, which otherwise
         swallows the last few pixels of the tap target. */
      nav {
        position: fixed;
        inset: auto 0 0 0;
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
        background: color-mix(in oklab, var(--ground) 92%, transparent);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--line);
        z-index: 10;
      }

      nav a {
        flex: 1 1 0;
        max-width: 8rem;
        padding: 0.6rem 0.5rem;
        border-radius: 10px;
        text-align: center;
        font-size: 0.85rem;
        text-decoration: none;
        color: var(--ink-dim);
      }

      nav a[aria-current="page"] {
        color: var(--ground);
        background: var(--accent);
        font-weight: 600;
      }

      /* Room for the bar, so a page's last element is never under it. */
      [data-surface="phone"] body {
        padding-bottom: 4.5rem;
      }
    </style>
  </head>
  <body>
    <slot />
    {
      surface === `phone` && (
        <nav aria-label="Sections">
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={here === href ? `page` : undefined}>
              {label}
            </a>
          ))}
        </nav>
      )
    }
  </body>
</html>
