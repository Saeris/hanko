---
import Base from "../layouts/Base.astro";
import { authenticate } from "../lib/hanko.js";

// The code arrives three ways, all landing on the same parameter: typed by
// hand, from a scanned QR (RFC 8628 §3.3.1's `verification_uri_complete`), or
// from a universal link that opened a native app.
const prefilled = Astro.url.searchParams.get(`user_code`) ?? ``;
const subject = authenticate(Astro.request);
---

<Base title="Approve sign-in — hanko" surface="phone">
  <main>
    {
      subject === null ? (
        <section class="card">
          <h1>Sign in first</h1>
          <p class="lead">
            Approving a device hands it your identity, so this page needs you
            signed in on this phone.
          </p>
          <a
            class="btn primary"
            href={`/signin?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
          >
            Sign in
          </a>
        </section>
      ) : (
        <section class="card" id="card" data-subject={subject}>
          <h1>Approve sign-in</h1>

          <div
            id="scanner"
            class:list={["step", prefilled && "hidden"]}
          >
            <p class="lead">Point your camera at the code on the other device.</p>
            <div class="viewfinder">
              <!-- `autoplay` and `playsinline` are both required on iOS: Safari
                   will not begin playback of a srcObject stream without them,
                   and without playback the element sits on a black first frame
                   that the decoder samples forever. `muted` is what makes
                   autoplay permissible at all. -->
              <video id="video" autoplay playsinline muted></video>
            </div>
            <p class="scan-status" id="scan-status" role="status" aria-live="polite">
              Starting camera…
            </p>
            <button class="btn ghost" type="button" id="use-code">
              Enter the code instead
            </button>
          </div>
          <form id="lookup" class="step hidden">
            <p class="lead">Enter the code shown on the other device.</p>

            <p class="lead">Enter the code shown on the other device.</p>
            <label class="field">
              <span>Code from the screen</span>
              <input
                id="code"
                name="user_code"
                value={prefilled}
                placeholder="WDJB"
                maxlength="8"
                enterkeyhint="go"
                autocomplete="one-time-code"
                autocorrect="off"
                autocapitalize="characters"
                spellcheck="false"
                required
              />
            </label>
            <button class="btn primary" type="submit">Continue</button>
          </form>

          <div id="confirm" class="step hidden">
            <div class="callout">
              <span class="callout-label">Signing in</span>
              <strong class="callout-client" id="client-name">A device</strong>
            </div>

            <p class="lead">
              You entered the code from this device's screen, which is what
              proves you can see it. Approve only if you started this sign-in.
            </p>

            <p class="error hidden" id="error" role="alert" />

            <div class="actions">
              <button class="btn primary" id="approve" type="button">
                Approve
              </button>
              <button class="btn ghost" id="deny" type="button">Deny</button>
            </div>
          </div>

          <p class="outcome hidden" id="outcome" role="status" aria-live="polite" />

          <p class="who">
            Signed in as <strong>{subject}</strong>
          </p>
        </section>
      )
    }
  </main>
</Base>

<script>
  import {
    ApprovalClient,
    noChallenge,
    consumeLaunchTarget,
    parseApprovalLink
  } from "@saeris/hanko/approve";

  const card = document.getElementById(`card`);
  if (card) {
    const $ = (id: string) => document.getElementById(id)!;
    const lookup = $(`lookup`) as HTMLFormElement;
    const codeInput = $(`code`) as HTMLInputElement;
    const approveBtn = $(`approve`) as HTMLButtonElement;
    const error = $(`error`);
    const outcome = $(`outcome`);
    const scanner = $(`scanner`);
    const video = $(`video`) as HTMLVideoElement;
    const scanStatus = $(`scan-status`);

    const show = (el: HTMLElement, on: boolean) =>
      el.classList.toggle(`hidden`, !on);

    // Typed loosely because the module is imported dynamically below — the
    // library manages the camera, so there is no MediaStream to hold here.
    let qrScanner: { stop: () => void; destroy: () => void } | null = null;

    /**
     * Release the camera.
     *
     * `destroy` rather than `stop`: it also tears down the worker. Leaving the
     * stream live drains the battery and keeps the recording indicator on,
     * which reads as the page spying.
     */
    const stopCamera = (): void => {
      qrScanner?.destroy();
      qrScanner = null;
    };

    const showCodeEntry = (): void => {
      stopCamera();
      show(scanner, false);
      show(lookup, true);
      codeInput.focus();
    };

    const client = new ApprovalClient({
      // The library never assumes a transport — the host wires its own fetches.
      resolve: async (userCode) => {
        const res = await fetch(
          `/api/link?user_code=${encodeURIComponent(userCode)}`
        );
        if (!res.ok) return null;
        const body = (await res.json()) as {
          user_code: string;
          client_id?: string;
        };
        return { userCode: body.user_code, clientId: body.client_id };
      },
      submit: async (userCode, approved) => {
        await fetch(`/api/link`, {
          method: `POST`,
          headers: { "content-type": `application/x-www-form-urlencoded` },
          body: new URLSearchParams({
            user_code: userCode,
            approved: String(approved)
          })
        });
      },
      // No challenge, because RFC 8628 §3.3.1 does not ask for one:
      //
      //   "The server SHOULD display the user_code to the user and ask them to
      //    verify that it matches the user_code being displayed on the device"
      //
      // The mitigation is the user COMPARING two physically separate screens,
      // then choosing approve or deny. Making them re-type a code they can see
      // is a memory test, not a possession check, and it is friction no
      // production implementation of this flow imposes.
      //
      // hanko still ships `codeEntryChallenge` and `tripletChallenge` for
      // hosts that want a higher bar on a riskier action — see the README.
      challenge: noChallenge(),
      hooks: {
        onTransition: (_from, to) => {
          // Past `resolving` the camera has done its job; releasing it here
          // rather than at the end means it is off during confirmation, when
          // the user is reading rather than pointing.
          if (to !== `idle` && to !== `scanning`) stopCamera();

          show(scanner, to === `idle` || to === `scanning`);
          show(lookup, false);
          show($(`confirm`), to === `confirming`);

          if (to === `confirming` && client.grant) {
            // Both halves of what §3.3.1 asks the server to show: which device
            // is asking, and the code to compare against that device's screen.
            $(`client-name`).textContent = client.grant.clientId ?? `A device`;

            // `noChallenge` passes immediately; running it here keeps the
            // machine's contract intact rather than special-casing the button.
            void client.confirm();
          }

          if (to === `invalid`) {
            outcome.textContent = `That code is not valid, or it has expired.`;
            outcome.dataset.tone = `bad`;
            show(outcome, true);
            // Falls back to typing rather than back to the camera: a scan that
            // resolved to nothing will keep resolving to nothing, and pointing
            // the camera again is a worse loop than reading the code off.
            showCodeEntry();
            client.reset();
          }
        },
        onChallengeFailed: (_reason, attempts) => {
          error.textContent =
            attempts > 2
              ? `Still no match. Check the code on the other screen.`
              : `That does not match.`;
          show(error, true);
        },
        onSettled: (state) => {
          show($(`confirm`), false);
          outcome.textContent =
            state === `approved`
              ? `Approved. The other device is signing in now.`
              : `Denied. Nothing was signed in.`;
          outcome.dataset.tone = state === `approved` ? `ok` : `bad`;
          show(outcome, true);

          // Lands on the device list, where the newly approved device appears
          // as a row you can revoke. Delayed so the outcome is readable first
          // — an instant redirect reads as the tap having done something
          // unrelated.
          if (state === `approved`) {
            setTimeout(() => {
              globalThis.location.href = `/account`;
            }, 1200);
          }
        },
        onError: () => {
          error.textContent = `Could not reach the server. Try again.`;
          show(error, true);
        }
      }
    });

    lookup.addEventListener(`submit`, (event) => {
      event.preventDefault();
      void client.submitCode(codeInput.value);
    });

    approveBtn.addEventListener(`click`, () => void client.approve());
    $(`deny`).addEventListener(`click`, () => void client.deny());

    // Handles an installed PWA launched by a scanned link. Falls back to
    // location.href where launchQueue is unsupported (Safari, Firefox), so no
    // branching is needed here.
    consumeLaunchTarget((href) => {
      const link = parseApprovalLink(href);
      if (link && client.state === `idle`) void client.submitCode(link.userCode);
    });

    $(`use-code`).addEventListener(`click`, showCodeEntry);

    /**
     * Open the camera and start decoding.
     *
     * `qr-scanner` owns the camera, the decode loop, and the worker. It uses
     * the native `BarcodeDetector` where one exists and falls back to its own
     * worker otherwise — which matters because that API is a WICG incubation
     * no major browser has committed to, and Safari has never shipped it.
     *
     * Imported dynamically so the worker only loads on a page that actually
     * opens a camera. The device screen never pays for it.
     */
    const startCamera = async (): Promise<void> => {
      const { default: QrScanner } = await import(`qr-scanner`);

      const scannerInstance = new QrScanner(
        video,
        (result: { data: string }) => {
          const link = parseApprovalLink(result.data);
          // A camera pointed at a room sees unrelated codes constantly. Each
          // miss is a non-event, not an error.
          if (!link) return;
          // Stop before submitting: a second frame decoding the same code
          // would fire submitCode twice and race the state machine.
          scannerInstance.stop();
          void client.submitCode(link.userCode);
        },
        {
          // Without this the callback receives a bare STRING, not an object,
          // so `result.data` is undefined and every scan is silently discarded
          // as "not a code". The library runs fine; it just never matches.
          returnDetailedScanResult: true,
          // The rear camera — the front one points at the user, not at the
          // screen they are trying to scan.
          preferredCamera: `environment`,
          // Draws the detected outline over the preview, so a partial read
          // looks like progress rather than nothing happening.
          highlightScanRegion: true,
          highlightCodeOutline: true,
          maxScansPerSecond: 10
        }
      );

      qrScanner = scannerInstance;

      try {
        await scannerInstance.start();

        // `start()` resolving only means the stream was ATTACHED. iOS Safari
        // will not begin playback of a srcObject stream on its own, and on
        // Safari a paused element yields no frames — permission granted,
        // preview black, nothing ever decodes.
        //
        // Deliberately no `videoWidth === 0` guard afterwards: qr-scanner
        // samples the MediaStreamTrack rather than the element, so Chromium
        // decodes fine from a paused, zero-size video. Treating that as
        // failure would break a scanner that works.
        if (video.paused) {
          try {
            await video.play();
          } catch {
            // Autoplay refused. The track may still be readable, so let the
            // scanner try rather than dead-ending on a preview problem.
          }
        }

        scanStatus.textContent = `Looking for a code…`;
      } catch {
        // Denied, unavailable, or an insecure context — getUserMedia needs
        // HTTPS. Typing always works, so fall through rather than dead-end.
        scanStatus.textContent = `No camera access. Enter the code instead.`;
        showCodeEntry();
      }
    };

    // Arrived with the code already in the URL — a scanned QR or a universal
    // link. Nothing left to scan, so skip the camera.
    if (codeInput.value) {
      void client.submitCode(codeInput.value);
    } else {
      void startCamera();
    }

    // Releases the camera when the page goes away. Without this the indicator
    // can linger after a back-navigation.
    window.addEventListener(`pagehide`, stopCamera);
  }
</script>

<style>
  main {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .card {
    width: min(100%, 26rem);
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--ground-lift);
  }

  h1 {
    margin: 0;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }

  .lead {
    margin: 0;
    color: var(--ink-dim);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .step {
    display: grid;
    gap: 1rem;
  }

  .hidden {
    display: none;
  }

  .viewfinder {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    /* No `overflow: hidden`: the library inserts its highlight overlay into
       this container, and clipping it hides the outline it draws around a
       detected code. */
    background: var(--ground);
    border: 1px solid var(--line);
  }

  .viewfinder video {
    width: 100%;
    height: 100%;
    /* `contain`, not `cover`. The library computes its scan region from the
       video's rendered box and draws its own highlight overlay into this
       container; `cover` crops the frame so the region it samples no longer
       matches what the user sees. Letterboxing is the honest trade. */
    object-fit: contain;
  }

  .scan-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-dim);
    text-align: center;
  }


  .callout {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--ground);
    text-align: center;
  }

  .callout-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .callout-code {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  input {
    /* 16px minimum: iOS Safari zooms the viewport on focus for anything
       smaller, which yanks the layout sideways mid-entry. */
    font: inherit;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--ground);
    color: var(--ink);
    text-transform: uppercase;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
  }

  .btn {
    /* 44px is Apple's minimum touch target; anything smaller is a mis-tap on a
       screen being held one-handed. */
    min-height: 44px;
    padding: 0.7rem 1.1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    font-weight: 600;
    text-decoration: none;
    display: grid;
    place-items: center;
  }

  .btn.primary {
    background: var(--accent);
    color: #2a1c05;
  }

  .btn.primary:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn.ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  .error {
    margin: 0;
    color: var(--bad);
    font-size: 0.875rem;
  }

  .outcome {
    margin: 0;
    font-weight: 600;
  }

  .outcome[data-tone="ok"] {
    color: var(--ok);
  }

  .outcome[data-tone="bad"] {
    color: var(--bad);
  }

  .who {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--ink-dim);
  }
</style>
