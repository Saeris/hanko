---
/**
 * Scanner diagnostics.
 *
 * A scanner fails silently by nature: a frame with no code in it and a broken
 * decode pipeline produce the same output, which is nothing. This page
 * separates them by reporting each stage on screen — there is no console on a
 * phone — and by counting decode attempts, since attempts without a result is
 * the healthy state and no attempts at all is the fault.
 */
import Base from "../layouts/Base.astro";
---

<Base title="Scanner diagnostics">
  <main>
    <h1>Scanner diagnostics</h1>
    <video id="video" playsinline muted></video>
    <ol id="log"></ol>
    <p><a href="/link">back to /link</a></p>
  </main>
</Base>

<script>
  const log = document.getElementById(`log`)!;
  const video = document.getElementById(`video`) as HTMLVideoElement;

  const say = (text: string, tone = ``): void => {
    const li = document.createElement(`li`);
    li.textContent = text;
    li.dataset.tone = tone;
    log.append(li);
  };

  // Anything thrown outside a promise chain — including a worker that fails
  // to construct — would otherwise vanish on a device with no console.
  addEventListener(`error`, (e) => say(`window error: ${e.message}`, `bad`));
  addEventListener(`unhandledrejection`, (e) =>
    say(`unhandled rejection: ${String(e.reason)}`, `bad`)
  );

  say(`secure context: ${String(isSecureContext)}`, isSecureContext ? `ok` : `bad`);
  say(`BarcodeDetector present: ${String(`BarcodeDetector` in globalThis)}`);
  say(`getUserMedia present: ${String(Boolean(navigator.mediaDevices?.getUserMedia))}`);

  // Kept as a control even though the decoder now uses a bundled module
  // worker rather than a blob URL. A CSP without `worker-src blob:` blocks
  // this one and not ours, so a failure here with a working scanner below
  // says the policy is tight rather than that anything is broken.
  try {
    const probe = new Worker(
      URL.createObjectURL(new Blob([`self.postMessage('alive')`], { type: `text/javascript` }))
    );
    probe.addEventListener(`message`, (e) => {
      say(`blob worker: ${String(e.data)}`, `ok`);
      probe.terminate();
    });
    probe.addEventListener(`error`, (e) =>
      say(`blob worker FAILED: ${e.message || `blocked`}`, `bad`)
    );
  } catch (error) {
    say(`blob worker threw: ${String(error)}`, `bad`);
  }

  try {
    const [{ createWorkerScanner }, { openCamera }] = await Promise.all([
      import(`@saeris/hanko/scan`),
      import(`../lib/camera`)
    ]);
    say(`decoder imported`, `ok`);

    const camera = await openCamera(video);
    const { width, height } = camera.settings;
    say(`camera ${width ?? `?`}x${height ?? `?`}`, `ok`);

    // A module worker rather than a blob URL. The previous scanner built its
    // engine from `blob:`, which iOS Safari can refuse with a SecurityError
    // that presents exactly like an empty viewfinder — the probe above exists
    // because of that. A bundled module worker has no such failure mode.
    const worker = new Worker(
      new URL(`../workers/decoder.ts`, import.meta.url),
      { type: `module` }
    );
    const scanner = createWorkerScanner(worker);
    say(`worker scanner constructed`, `ok`);

    let attempts = 0;
    let dropped = 0;
    let slowest = 0;

    const pump = async (): Promise<void> => {
      for (;;) {
        const frame = camera.grab();

        if (frame === null) {
          // No painted frame yet. On iOS a paused element yields nothing, so
          // this is worth distinguishing from "decoding and failing".
          await new Promise((resolve) => requestAnimationFrame(resolve));
          continue;
        }

        const started = performance.now();
        const symbol = await scanner.scan(frame);
        const elapsed = performance.now() - started;

        // A frame offered while a decode is in flight is dropped and returns
        // instantly; counting those separately keeps the rate honest.
        if (elapsed <= 1) {
          dropped++;
        } else {
          attempts++;
          if (elapsed > slowest) slowest = elapsed;
        }

        if (symbol !== null) {
          say(`DECODED: ${symbol.value}`, `ok`);
          scanner.close();
          camera.stop();
          return;
        }

        await new Promise((resolve) => requestAnimationFrame(resolve));
      }
    };

    void pump();

    // Proof the loop is running at all. Attempts with no decode is the
    // HEALTHY state when nothing is in view; zero attempts is the fault.
    setTimeout(() => {
      say(
        attempts === 0
          ? `NO decode attempts after 3s — the pump is not running`
          : `${attempts} attempts in 3s (${dropped} dropped, slowest ${slowest.toFixed(0)}ms) — loop is alive`,
        attempts === 0 ? `bad` : `ok`
      );
    }, 3000);
  } catch (error) {
    say(`FATAL: ${String(error)}`, `bad`);
  }
</script>

<style>
  main { padding: 1rem; font-family: system-ui, sans-serif; }
  video { width: 100%; max-width: 22rem; border-radius: 8px; background: #000; }
  ol { font-family: ui-monospace, monospace; font-size: 0.8rem; line-height: 1.5; padding-left: 1.2rem; }
  li[data-tone="ok"] { color: #2e7d32; }
  li[data-tone="bad"] { color: #c62828; font-weight: 600; }
</style>
