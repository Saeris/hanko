---
import Base from "../layouts/Base.astro";
import { originOf } from "../lib/hanko.js";

// Derived from this request, so it reports the host the browser actually
// reached rather than whatever the server was configured with at boot.
const origin = originOf(Astro.request, Astro.url);
const isLocal = /localhost|127\.0\.0\.1/u.test(origin);
---

<Base title="hanko demo" surface="phone">
  <main>
    <section class="card">
      <h1>hanko demo</h1>
      <p class="lead">
        Three devices, one flow. Open each surface on the device that plays its
        part.
      </p>

      <ol class="steps">
        <li>
          <a href="/signin">Sign in</a> on your phone. This identity is what the
          other device inherits.
        </li>
        <li>
          Open <a href="/tv">the TV screen</a> on a second device — a browser
          tab, a Pi, a Fire Stick.
        </li>
        <li>
          Scan its QR with your phone camera, or type the code at
          <a href="/link">/link</a>.
        </li>
        <li>
          Manage what you have approved at
          <a href="/account">/account</a> — revoke a device and its next
          request stops resolving.
        </li>
      </ol>

      <p class="tools">
        Just want to read a code? <a href="/scanner">/scanner</a> decodes
        anything you point it at. <a href="/scanner-debug">/scanner-debug</a>
        reports each stage on screen, for when a phone has no console to check.
      </p>

      <p class="note" data-tone={isLocal ? `warn` : `ok`}>
        Serving from <code>{origin}</code>.{` `}
        {
          isLocal
            ? `A phone cannot reach this, and the camera needs HTTPS — run \`yarn demo:share\` and open the printed URL.`
            : `Open this same URL on your phone; the QR is built from it automatically.`
        }
      </p>
    </section>
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }
  .card {
    width: min(100%, 32rem);
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--ground-lift);
  }
  h1 {
    margin: 0;
    font-size: 1.5rem;
  }
  .lead {
    margin: 0;
    color: var(--ink-dim);
    line-height: 1.5;
  }
  .steps {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
    line-height: 1.55;
  }
  a {
    color: var(--accent);
  }
  .tools {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--ink-dim);
    line-height: 1.55;
  }
  .note {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.5;
  }
  /* Says at a glance whether the current URL can reach a phone — the one
     precondition that makes everything else fail silently. */
  .note[data-tone="warn"] code {
    color: var(--bad);
  }
  .note[data-tone="ok"] code {
    color: var(--ok);
  }
  code {
    color: var(--ink);
  }
</style>
