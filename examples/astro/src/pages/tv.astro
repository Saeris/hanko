---
import { renderDeviceQr } from "@saeris/hanko";
import Base from "../layouts/Base.astro";
import {
  originOf,
  publicDeviceId,
  resumeOrCreateGrant
} from "../lib/hanko.js";

// The origin the browser actually reached. A grant created here is only
// reachable through the SAME origin — the store is shared, but the QR and the
// approval page have to agree on a host the phone can resolve.
const origin = originOf(Astro.request, Astro.url);
const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/u.test(origin);

// Refuse rather than render an unusable screen. Opening this page on
// `localhost` while the phone is on a tunnel produces a QR the phone cannot
// reach AND a code stored against an origin its requests never carry — both
// fail silently, which is the worst way for a sign-in screen to fail.
//
// Reused across reloads rather than minted per render. A page render must not
// be a side effect: without this, refreshing the screen — or opening it in a
// second tab — silently replaces the code someone is halfway through typing,
// and the old one keeps working, so two live codes disagree about which is
// "the" code.
const grant = isLocal
  ? null
  : // Started server-side so the screen paints with a code already on it.
    // Doing this in the browser would show an empty panel for a round trip,
    // which on a TV reads as the app having failed to load.
    await resumeOrCreateGrant({
      cookies: Astro.cookies,
      clientId: `demo-tv`,
      verificationUri: `${origin}/link`,
      // The QR carries WHICH device is asking, not the code that approves it.
      // A photograph of the screen then reveals only an identifier; approving
      // still needs the code read off that same screen. Two independent facts,
      // neither sufficient alone.
      buildQrTarget: async (deviceCode) =>
        `${origin}/link?device=${await publicDeviceId(deviceCode)}`
    });

const qr =
  grant === null
    ? null
    : renderDeviceQr(grant.verification_uri_complete!, {
        size: 340,
        // Light modules on the dark panel. Scanners need contrast, not a
        // specific polarity — but the quiet zone has to match the modules,
        // hence the dark background rather than a transparent one.
        color: `#f0b429`,
        background: `#160c1e`
      });

// Shown without the scheme: the user is retyping this from across a room, and
// "https://" is eight characters of noise they do not need.
const typedUrl = grant?.verification_uri.replace(/^https?:\/\//u, ``) ?? ``;
---

<Base title="Sign in — hanko" surface="tv">
  <main>
    {
      grant === null ? (
        <section class="blocked">
          <h1>Open this on a URL your phone can reach</h1>
          <p class="lead">
            This page is being served from <code>{origin}</code>, which only
            this machine can resolve. A code created here would be unreachable
            from a phone, so none is shown.
          </p>
          <p class="lead">
            Run <code>yarn demo:share</code> and open the tunnel URL it prints
            — the terminal also shows it as a QR you can scan.
          </p>
        </section>
      ) : (
        <>
          <h1>Sign in to this device</h1>

          <div class="paths" id="paths">
            <section class="path">
              <p class="lead">Visit this link in a browser</p>
              <p class="url">{typedUrl}</p>
              <p class="lead">and enter this code</p>
              <p
                class="code"
                aria-label={`Code: ${grant.user_code.split("").join(" ")}`}
              >
                {grant.user_code}
              </p>
            </section>

            <div class="divider" aria-hidden="true">
              <span>OR</span>
            </div>

            <section class="path">
              <p class="lead">
                Use the camera on your phone<br />to scan the QR code
              </p>
              <div class="qr" set:html={qr} />
            </section>
          </div>

          <p class="status" id="status" role="status" aria-live="polite">
            Waiting for approval…
          </p>
        </>
      )
    }
  </main>
</Base>

<script
  is:inline
  define:vars={{
    // Null when the origin is local and no grant was created. The loop below
    // bails on that rather than polling for a code that does not exist.
    deviceCode: grant?.device_code ?? null,
    interval: grant?.interval ?? 5,
    expiresIn: grant?.expires_in ?? 0
  }}
>
  // Inline and dependency-free on purpose: this is the code that runs on a Fire
  // Stick or a Pi, where every fetch costs and the JS engine is modest. The
  // library's own client would work here too — this keeps the demo's TV bundle
  // at zero bytes of framework.
  // No grant means the blocked screen is showing; there is nothing to poll.
  if (deviceCode !== null) {
  const status = document.getElementById(`status`);
  const deadline = Date.now() + expiresIn * 1000;
  let wait = interval;

  const set = (text, tone) => {
    status.textContent = text;
    status.dataset.tone = tone ?? ``;
  };

  /**
   * Replace the sign-in panel with an outcome.
   *
   * The code and QR are stale the moment the flow resolves — leaving them on
   * screen invites someone to scan a code that can never work. A TV is also
   * read from across a room, so the outcome has to be the whole screen rather
   * than a line of small text under an unchanged panel.
   */
  const finish = (heading, detail, tone) => {
    document.getElementById(`paths`)?.remove();
    document.querySelector(`h1`).textContent = heading;
    set(detail, tone);
    document.body.dataset.settled = tone;
  };

  /**
   * Notice when this device's session is revoked.
   *
   * Stands in for the API calls a real app would be making anyway — any one of
   * them would come back 401 and trigger the same handling. Without it, a
   * device revoked from the account screen sits on "You're signed in"
   * indefinitely, which is exactly the wrong thing for a revocation UI to do.
   */
  const watchSession = (token) => {
    const check = async () => {
      try {
        const res = await fetch(`/api/session`, {
          headers: { authorization: `Bearer ${token}` }
        });
        if (res.status === 401) {
          finish(
            `Signed out`,
            `This device's access was revoked. Reload to sign in again.`,
            `bad`
          );
          return;
        }
      } catch {
        // Offline. Not evidence of revocation — keep watching.
      }
      setTimeout(() => void check(), 5000);
    };
    setTimeout(() => void check(), 5000);
  };

  const poll = async () => {
    if (Date.now() >= deadline) {
      finish(`That code expired`, `Reload this page to get a new one.`, `bad`);
      return;
    }

    let body;
    try {
      const res = await fetch(`/api/device/token`, {
        method: `POST`,
        headers: { "content-type": `application/x-www-form-urlencoded` },
        body: new URLSearchParams({
          grant_type: `urn:ietf:params:oauth:grant-type:device_code`,
          device_code: deviceCode
        })
      });
      body = await res.json();
    } catch {
      // Venue wifi drops. Exponential here, unlike slow_down's fixed +5s —
      // congestion, not server policy.
      wait = Math.min(wait * 2, 60);
      setTimeout(poll, wait * 1000);
      return;
    }

    switch (body.error) {
      case `authorization_pending`:
        setTimeout(poll, wait * 1000);
        return;
      case `slow_down`:
        // Additive and permanent, per RFC 8628 §3.5. Never reset it.
        wait += 5;
        setTimeout(poll, wait * 1000);
        return;
      case `access_denied`:
        finish(`Sign-in denied`, `Nothing was signed in on this device.`, `bad`);
        return;
      case `expired_token`:
        finish(
          `That code expired`,
          `Reload this page to get a new one.`,
          `bad`
        );
        return;
      case undefined:
        // No error field means the grant was redeemed. The device replaces the
        // whole screen rather than nudging a status line: the code and QR are
        // now stale, and leaving them up invites someone to scan a code that
        // will never resolve.
        finish(
          `You're signed in`,
          `Signed in as ${body.subject}. You can start using this device.`,
          `ok`
        );
        // The device flow is over — polling the token endpoint again would be
        // wrong. But the SESSION can still be revoked from the account screen,
        // and a real app would discover that on its next API call. This screen
        // makes no calls, so it watches its own session instead.
        watchSession(body.access_token);
        return;
      default:
        // An unrecognized code is not evidence the user decided anything.
        setTimeout(poll, wait * 1000);
    }
  };

  setTimeout(poll, wait * 1000);
  }
</script>

<style>
  main {
    /* Sized for the 1920x1080 the Fire Stick outputs, but in relative units so
       it still reads on the 1280x720 a Pi might drive. */
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 2vh;
    padding: 6vh 6vw;
    place-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .paths {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 5rem);
    width: min(100%, 1400px);
  }

  .path {
    display: grid;
    justify-items: center;
    gap: 1.2vh;
    /* Establishes the container the code sizes against, so it scales to its
       own column rather than to the viewport — the column is what actually
       constrains it. */
    container-type: inline-size;
  }

  .lead {
    margin: 0;
    font-size: clamp(0.95rem, 1.35vw, 1.5rem);
    color: var(--ink-dim);
    text-align: center;
    line-height: 1.45;
  }

  .url {
    margin: 0;
    font-size: clamp(1.2rem, 1.9vw, 2.1rem);
    font-weight: 700;
    color: var(--accent);
  }

  .code {
    margin: 0.5vh 0 0;
    /* The whole point of the screen: legible from across a room. Tracked wide
       so adjacent characters cannot be misread, and tabular so the string does
       not reflow as digits change.

       `nowrap` is not cosmetic: a wrapped code reads as TWO codes, and a user
       could reasonably type only the first half. It must break the layout
       before it breaks the string. Sized off the column (cqw) rather than the
       viewport so it shrinks to fit that column instead of overflowing it. */
    font-size: clamp(2rem, 13cqw, 5rem);
    white-space: nowrap;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-indent: 0.14em;
  }

  .divider {
    align-self: stretch;
    display: grid;
    place-items: center;
    position: relative;
    color: var(--ink-dim);
    font-size: clamp(0.85rem, 1.1vw, 1.15rem);
    letter-spacing: 0.1em;
  }

  .divider::before,
  .divider::after {
    content: "";
    position: absolute;
    width: 1px;
    background: var(--line);
    left: 50%;
  }

  .divider::before {
    top: 0;
    height: calc(50% - 1.6em);
  }

  .divider::after {
    bottom: 0;
    height: calc(50% - 1.6em);
  }

  .qr {
    display: grid;
    padding: clamp(0.6rem, 1vw, 1rem);
    border-radius: 12px;
    background: var(--ground);
    /* The quiet zone is part of the symbol. Without the border the panel
       gradient bleeds into it and scan rate drops at distance. */
    border: 1px solid var(--line);
  }

  .qr :global(svg) {
    display: block;
    width: clamp(180px, 18vw, 340px);
    height: auto;
  }

  .blocked {
    grid-row: 1 / -1;
    align-self: center;
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    text-align: center;
  }

  .blocked h1 {
    font-size: clamp(1.4rem, 2.6vw, 2.5rem);
  }

  .blocked code {
    color: var(--accent);
    word-break: break-all;
  }

  .status {
    margin: 0;
    font-size: clamp(0.9rem, 1.2vw, 1.3rem);
    color: var(--ink-dim);
  }

  /* The settled screen centres its message rather than leaving it pinned to
     the bottom where the status line used to sit. */
  body[data-settled] main {
    grid-template-rows: 1fr auto 1fr;
    place-content: center;
  }

  .status[data-tone="ok"] {
    color: var(--ok);
    font-weight: 600;
  }

  .status[data-tone="bad"] {
    color: var(--bad);
    font-weight: 600;
  }

  /* A TV is landscape and fixed. This only fires when the demo is opened on a
     narrow window, which is how it gets previewed on a laptop. */
  @media (max-width: 800px) {
    .paths {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .divider::before,
    .divider::after {
      display: none;
    }
  }
</style>
