{
  "$schema": "../node_modules/@varlock/bumpy/config-schema.json",
  "baseBranch": "main",
  "changelog": "github",
  "githubRelease": true,
  "packages": {
    "@saeris/hanko": {
      "buildCommand": "vp pack"
    },
    "@saeris/hanko-example-astro": {
      "skipNpmPublish": true,
      "publishCommand": "yarn workspace @saeris/hanko-example-astro run deploy"
    }
  },
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "allowCustomCommands": true
}
