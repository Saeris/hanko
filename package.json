{
  "name": "hanko-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "ci": "yarn build && vp check && vp test",
    "build": "yarn workspace @saeris/hanko run build",
    "check": "vp check",
    "format": "vp check --fix",
    "test": "vp test --fileParallelism",
    "demo": "yarn build && yarn workspace @saeris/hanko-example-astro run dev",
    "demo:lan": "yarn build && portless run --name hanko --lan"
  },
  "devDependencies": {
    "@saeris/configs": "1.6.1",
    "@types/node": "^25.9.1",
    "@varlock/bumpy": "^1.7.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.0"
}
